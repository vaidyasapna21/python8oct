    "n=int(input(\"enter number\"))\n",
    "prime=True\n",
    "for i in range(2,n):\n",
    "    if n%i==0:\n",
    "      prime=False\n",
    "      break\n",
    "if prime:\n",
    "    print(\"  prime\" )\n",
    "else:\n",
    "    print(\" Not prime\")"
